{
  "name": "baby-tracker",
  "version": "1.6.6",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:prepare": "node scripts/prisma-provider.js",
    "prisma:generate": "npm run prisma:prepare && prisma generate",
    "prisma:generate:log": "npm run prisma:prepare && prisma generate --config prisma/log.config.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push:log": "prisma db push --config prisma/log.config.ts",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:studio:log": "prisma studio --config prisma/log.config.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "setup:vapid": "tsx scripts/setup-vapid-keys.ts",
    "notification:cron:setup": "tsx scripts/setup-notification-cron.ts",
    "notification:cron:run": "bash scripts/run-notification-cron.sh",
    "env:ensure": "node scripts/ensure-env-defaults.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
